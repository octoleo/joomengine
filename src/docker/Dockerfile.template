{{
	def is_apache:
		env.VARIANT == "apache";
	def is_mcp:
		env.IMAGE_FLAVOR == "mcp";
	def mcp:
		env.IMAGE_MCP_METADATA | fromjson
-}}
# -----------------------------------------------------------------------------
# Official JCB v{{ env.JCB_VERSION }} image: extend the official Joomla! v{{ env.JOOMLA_VERSION }} image
# -----------------------------------------------------------------------------
FROM joomla:{{ env.JOOMLA_VERSION }}-php{{ env.PHP_VERSION }}-{{ env.VARIANT }}@{{ env.BASE_IMAGE_INDEX_DIGEST }}

# Metadata
LABEL maintainer="{{ env.MAINTAINERS }}"
LABEL org.opencontainers.image.title="Joomla! Component Builder - JoomEngine"
LABEL org.opencontainers.image.description="Joomla! v{{ env.JOOMLA_VERSION }} + Component Builder v{{ env.JCB_VERSION }}{{ if is_mcp then " + JoomEngine MCP v" + mcp.version else "" end }}"
LABEL org.opencontainers.image.version="{{ env.JCB_VERSION }}"
LABEL org.opencontainers.image.source="https://github.com/octoleo/joomengine"
LABEL org.opencontainers.image.base.name="docker.io/library/joomla:{{ env.JOOMLA_VERSION }}-php{{ env.PHP_VERSION }}-{{ env.VARIANT }}"
LABEL org.opencontainers.image.base.digest="{{ env.BASE_IMAGE_INDEX_DIGEST }}"

# -----------------------------------------------------------------------------
# JCB metadata (required at build-time)
# -----------------------------------------------------------------------------
ENV JCB_VERSION {{ env.JCB_VERSION }}
ENV JCB_SHA512 {{ env.JCB_SHA512 }}
ENV JCB_PACKAGE {{ env.JCB_DOWNLOAD_URL }}
ENV JCB_INSTALL_DIR /usr/src/joomengine

# -----------------------------------------------------------------------------
# Download & verify JCB package (immutable, pinned, hash-verified)
# -----------------------------------------------------------------------------
RUN set -eux; \
	mkdir -p "$JCB_INSTALL_DIR"; \
	curl -fSL "$JCB_PACKAGE" -o "$JCB_INSTALL_DIR/jcb.zip"; \
	echo "$JCB_SHA512  $JCB_INSTALL_DIR/jcb.zip" | sha512sum -c -; \
	chown -R www-data:www-data "$JCB_INSTALL_DIR"

{{ if is_mcp then ( -}}
# -----------------------------------------------------------------------------
# Optional JoomEngine MCP package (component and plugins, pinned at image build)
# -----------------------------------------------------------------------------
LABEL org.joomengine.mcp.version="{{ mcp.version }}"
LABEL org.joomengine.mcp.sha512="{{ mcp.sha512 }}"
LABEL org.joomengine.mcp.source="{{ mcp.url }}"
ENV MCP_VERSION={{ mcp.version }}
ENV MCP_SHA512={{ mcp.sha512 }}
ENV MCP_PACKAGE={{ mcp.url }}

RUN set -eux; \
	curl -fSL "$MCP_PACKAGE" -o "$JCB_INSTALL_DIR/mcp.zip"; \
	echo "$MCP_SHA512  $JCB_INSTALL_DIR/mcp.zip" | sha512sum -c -; \
	chown www-data:www-data "$JCB_INSTALL_DIR/mcp.zip"

{{ ) else "" end -}}
# -----------------------------------------------------------------------------
# JCB entrypoint
# -----------------------------------------------------------------------------
COPY docker-entrypoint.sh /entrypoint.sh
RUN set -eux; \
	chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
{{ if is_apache then ( -}}
CMD ["apache2-foreground"]
{{ ) else ( -}}
CMD ["php-fpm"]
{{ ) end -}}
